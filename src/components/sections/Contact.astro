---
import FlipCard from '../../components/card.tsx';
import '../../styles/skill-card.scss';
const myCards = [`<div style="background: rgba(34, 34, 34, 0.8); backdrop-filter: blur(10px); color: #fff; padding: 2rem; border-radius: 16px; height: 100%; border: 1px solid #444; display: flex; flex-direction: column; justify-content: space-between;"><h3>Contact Me</h3><p>Get in touch.</p></div>`, `<div style="background: rgba(51, 51, 51, 0.8); backdrop-filter: blur(10px); color: #fff; padding: 2rem; border-radius: 16px; height: 100%; border: 1px solid #555; display: flex; flex-direction: column; justify-content: space-between;"><h3>Socials</h3><p>GitHub / LinkedIn</p></div>`];
---
<section id="contact" class="card-section"><div class="card-wrapper"><FlipCard client:load cards={myCards} /></div></section>