---
import FlipCard from "../../components/card.tsx";
import "../../styles/contact-card.scss";

const contactData = {
    email: "lou.vigier@epita.fr",
    github: "https://github.com/Lou-vgr",
    githubHandle: "github.com/Lou-vgr",
    linkedin: "https://linkedin.com/in/lou-vigier",
    linkedinHandle: "linkedin.com/in/lou-vigier",
    cvFr: "/cv-fr.pdf",
    cvEn: "/cv-en.pdf",
};

const myCards = [
    `
        <div class="contact-card-content">
            <div class="contact-header">
                <h3 class="contact-title">Contact</h3>
            </div>

            <div class="contact-grid">
                <div class="contact-method-group">
                    <h4>Direct Contact</h4>
                    
                    <a href="mailto:${contactData.email}" class="contact-item" onclick="event.stopPropagation()">
                        <div class="icon-wrapper">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                        </div>
                        <div class="contact-text">
                            <span class="label">Email</span>
                            <span class="value">${contactData.email}</span>
                        </div>
                    </a>

                    <a href="${contactData.github}" target="_blank" rel="noopener noreferrer" class="contact-item" onclick="event.stopPropagation()">
                        <div class="icon-wrapper">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/></svg>
                        </div>
                        <div class="contact-text">
                            <span class="label">GitHub</span>
                            <span class="value">${contactData.githubHandle}</span>
                        </div>
                    </a>

                    <a href="${contactData.linkedin}" target="_blank" rel="noopener noreferrer" class="contact-item" onclick="event.stopPropagation()">
                        <div class="icon-wrapper">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
                        </div>
                        <div class="contact-text">
                            <span class="label">LinkedIn</span>
                            <span class="value">${contactData.linkedinHandle}</span>
                        </div>
                    </a>
                </div>

                <div class="cv-download-group">
                    <h4>Curriculum Vitae</h4>
                    <div class="cv-buttons">
                        <a href="${contactData.cvFr}" download="CV_Lou_Vigier_FR.pdf" class="cv-button cv-fr" onclick="event.stopPropagation()">
                            <span class="flag">🇫🇷</span>
                            <span class="btn-text">Download CV (FR)</span>
                            <svg class="download-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                        </a>
                        
                        <a href="${contactData.cvEn}" download="CV_Lou_Vigier_EN.pdf" class="cv-button cv-en" onclick="event.stopPropagation()">
                            <span class="flag">🇬🇧</span>
                            <span class="btn-text">Download CV (EN)</span>
                            <svg class="download-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    `,
];
---

<section id="contact" class="card-section">
    <div class="card-wrapper" id="contact-wrapper">
        <FlipCard client:visible cards={myCards} />
    </div>
</section>
