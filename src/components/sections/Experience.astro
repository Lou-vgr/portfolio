---
import FlipCard from '../../components/card.tsx';
import { getCollection } from 'astro:content';
import '../../styles/experience-card.scss';

const expEntries = await getCollection('experiences');

const myCards = expEntries.map((entry) => {
    const { title, company, location, team, period, description, technologies, missions } = entry.data;

    const techListHtml = technologies
        .map((tech) => `<li>${tech}</li>`)
        .join('');

    const missionsListHtml = missions
        .map((mission) => `<li>${mission}</li>`)
        .join('');

    return `
        <div class="experience-card-content">
            <div class="exp-header">
                <div>
                    <h3 class="exp-title">${title}</h3>
                    <div class="exp-meta">
                        <span class="exp-company">${company}</span>
                        <span class="exp-dot">•</span>
                        <span class="exp-team">${team}</span>
                    </div>
                </div>
                <div class="exp-badges">
                    <span class="exp-badge exp-location">${location}</span>
                    <span class="exp-badge exp-period">${period}</span>
                </div>
            </div>
            
            <div class="exp-body">
                <p>${description}</p>
                
                <h3>Key Missions & Accomplishments</h3>
                <ul>
                    ${missionsListHtml}
                </ul>
            </div>
            
            <div class="project-tech-section">
                <ul class="tech-grid">
                    ${techListHtml}
                </ul>
            </div>
        </div>
    `;
});
---

<section id="experience" class="card-section">
    <div class="card-wrapper" id="experience-wrapper">
        <FlipCard client:load cards={myCards} />
    </div>
</section>