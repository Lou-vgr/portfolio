---
import MeshText from '../../components/title.tsx';
import '../../styles/hero.scss';
---
<section id="hero" class="hero-section">
    <div class="hero-content">
        <div class="hero-title-wrapper">
            <MeshText client:load text="Full-Stack Dev" font={{ fontFamily: "Orbitron", variant: "Bold", fontSize: 90 }} style={{ filter: "drop-shadow(0 0 15px rgba(255, 255, 255, 0.2)) drop-shadow(0 0 30px rgba(22, 0, 220, 0.4))", width: "100%", height: "100%" }} />
        </div>
        <p class="hero-subtitle">Final-year student at <a href="https://www.epita.fr" target="_blank" rel="noopener noreferrer" class="epita-badge">EPITA</a></p>
    </div>
</section>