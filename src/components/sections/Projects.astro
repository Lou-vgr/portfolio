---
import FlipCard from '../../components/card.tsx';
import { getCollection } from 'astro:content';
import '../../styles/project-card.scss';

const projectsEntries = await getCollection('projects');
const sortedProjects = projectsEntries.sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));

const myCards = sortedProjects.map((entry) => {
    const { title, description, technologies, link, github } = entry.data;

    const techListHtml = technologies
        .map((tech) => `<li>${tech}</li>`)
        .join('');

    const linkHtml = link
        ? `<a href="${link}" target="_blank" rel="noopener noreferrer" class="project-link" onclick="event.stopPropagation()">Live Demo</a>`
        : `<span class="project-private">Not deployed or private</span>`;

    const githubHtml = github
        ? `<a href="${github}" target="_blank" rel="noopener noreferrer" class="project-link" onclick="event.stopPropagation()">GitHub</a>`
        : `<span class="project-private">Private Repo</span>`;

    return `
        <div class="skill-card-content">
            <h3 class="skill-title">${title}</h3>
            <p class="project-desc">${description}</p>
            <div class="project-tech-section">
                <ul class="tech-grid">
                    ${techListHtml}
                </ul>
            </div>
            <div class="external-project-links" onclick="event.stopPropagation()">
                ${linkHtml}
                ${githubHtml}
            </div>
        </div>
    `;
});
---
<section id="projects" class="card-section">
    <div class="card-wrapper" id="projects-wrapper">
        <FlipCard client:visible cards={myCards} />
    </div>
    <div class="hint-pulse" id="project-hint">
        Click on the card to discover other projects
    </div>
</section>

<script>
    const wrapper = document.getElementById('projects-wrapper');
    const hint = document.getElementById('project-hint');

    if (wrapper && hint) {
        const hideHint = () => {
            hint.style.opacity = '0';
            hint.style.visibility = 'hidden';
            wrapper.removeEventListener('click', hideHint);
        };

        wrapper.addEventListener('click', hideHint, { once: true });
    }
</script>