---
import FlipCard from '../../components/card.tsx';
import { getCollection } from 'astro:content';
import '../../styles/skill-card.scss';

const skillsEntries = await getCollection('skills');

const sortedIds = ['front', 'back', 'devops', 'soft'];
const sortedSkills = sortedIds
    .map(id => skillsEntries.find(entry => entry.id === id))
    .filter((entry): entry is NonNullable<typeof entry> => entry !== undefined);

const myCards = sortedSkills.map((entry) => {
    const bodyContent = entry.body ?? '';
    const lines = bodyContent.split('\n');
    let rowsHtml = '';

    for (const line of lines) {
        if (line.includes('|') && !line.includes('---') && !line.toLowerCase().includes('skill')) {
            const parts = line.split('|').map(p => p.trim()).filter(Boolean);
            if (parts.length >= 2) {
                const name = parts[0];
                const score = Number(parts[1]);
                const percentage = score * 10;

                rowsHtml += `
                    <tr>
                        <td style="padding: 0; border: none;">
                            <div class="skill-row-container">
                                <span class="skill-name">${name}</span>
                                <div class="skill-bar-track">
                                    <div class="skill-bar-fill" style="width: ${percentage}%;"></div>
                                </div>
                            </div>
                        </td>
                    </tr>
                `;
            }
        }
    }

    return `
        <div class="skill-card-content">
            <h3>${entry.data.title}</h3>
            <table>
                ${rowsHtml}
            </table>
        </div>
    `;
});
---
<section id="skills" class="card-section">
    <div class="card-wrapper" id="skills-wrapper">
        <FlipCard client:load cards={myCards} />
        <div class="hint-pulse" id="skill-hint">
            Click on the card to discover other skills
        </div>
    </div>
</section>

<script>
    const wrapper = document.getElementById('skills-wrapper');
    const hint = document.getElementById('skill-hint');

    if (wrapper && hint) {
        const hideHint = () => {
            hint.style.opacity = '0';
            hint.style.visibility = 'hidden';
            wrapper.removeEventListener('click', hideHint);
        };

        wrapper.addEventListener('click', hideHint, { once: true });
    }
</script>