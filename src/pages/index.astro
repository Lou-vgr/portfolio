---
import Layout from '../layouts/Layout.astro';
import Header from '../components/sections/Header.astro';
import Timeline from '../components/sections/Timeline.astro';
import Background from '../components/sections/Background.astro';
import Hero from '../components/sections/Hero.astro';
import Skills from '../components/sections/Skills.astro';
import Projects from '../components/sections/Projects.astro';
import Experience from '../components/sections/Experience.astro';
import Contact from '../components/sections/Contact.astro';
---
<Layout>
    <Header />
    <Timeline />
    <Background />
    <main style="position: relative; z-index: 1;">
        <Hero />
        <Skills />
        <Projects />
        <Experience />
        <Contact />
    </main>
    <footer style="text-align: center; padding: 2rem 0; font-size: 0.85rem; color: #888888;">
        <p>&copy; 2026 Lou Vigier. All rights reserved. | <a>Legal Notice</a></p>
        <div id="legal" style="margin-top: 1rem; font-size: 0.75rem; color: #555555;">
            <p>Published by Lou Vigier (Private individual).</p>
            <p>Hosted by Hostinger International Ltd., 61 Lordou Vironos Street, 6023 Larnaca, Cyprus.</p>
        </div>
    </footer>
    <script src="../scripts/timelineObserver.ts"></script>
</Layout>